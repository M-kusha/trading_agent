# Cloud Training Dockerfile - GPU Optimized
# Build: docker build -t ai-trading-trainer -f cloud_training/Dockerfile.gpu .
# Run:   docker run --gpus all -v $(pwd)/checkpoints:/app/checkpoints ai-trading-trainer

FROM nvidia/cuda:11.8-cudnn8-runtime-ubuntu22.04

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-get update && apt-get install -y \
    python3.11 \
    python3.11-venv \
    python3-pip \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set Python 3.11 as default
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1 && \
    update-alternatives --install /usr/bin/python python /usr/bin/python3.11 1

WORKDIR /app

# Copy requirements first (for Docker cache)
COPY cloud_training/requirements_cloud.txt ./requirements.txt

# Install Python dependencies
RUN pip install --upgrade pip wheel setuptools && \
    pip install torch torchvision --index-url https://download.pytorch.org/whl/cu118 && \
    pip install -r requirements.txt

# Copy application code
COPY envs/ ./envs/
COPY modules/ ./modules/
COPY train/ ./train/
COPY config/ ./config/
COPY data/ ./data/
COPY utils/ ./utils/

# Create necessary directories
RUN mkdir -p checkpoints logs/tensorboard models/best state

# Verify GPU access
RUN python -c "import torch; print(f'CUDA available: {torch.cuda.is_available()}')"

# Default command: run fast training
CMD ["python", "train/train_ppo_hybrid.py", \
     "--mode", "offline", \
     "--preset", "training_fast", \
     "--timesteps", "5000000", \
     "--auto-pretrained", \
     "--no-dashboard"]
