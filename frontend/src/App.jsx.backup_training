    while (updateQueue.current.length > 0) {
      const update = updateQueue.current.shift();

      // Use startTransition to keep UI interactions responsive
      startTransition(() => {
        switch (update.type) {
          case 'system_state': {
            const stateData = update.data || {};
            setSystemState(prev => ({ ...prev, ...stateData }));
