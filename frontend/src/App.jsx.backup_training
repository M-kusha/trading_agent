                          y={bodyTop}
                          width={10}
                          height={Math.max(bodyHeight, 1.5)}
                          fill={isGreen ? 'transparent' : '#EF4444'}
                          stroke={isGreen ? '#10B981' : '#EF4444'}
                          strokeWidth={1.8}
                        />
