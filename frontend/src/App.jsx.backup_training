              return filtered;
            });
            setSystemMetrics(prev => ({ ...prev, ...(stateData.system_metrics || {}) }));
            setTrainingProgress(stateData.training_progress || null);
            break;
          }
          case 'training_metrics': {
            setTrainingMetrics(update.data);
